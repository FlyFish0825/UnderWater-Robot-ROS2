<?xml version="1.0"?>
<!-- 只读监视启动层：base 层（网关 + 传感器 + 双目相机）+ robot_node 心跳，不启动推力分配器。
     端口沿用 base 约定：9000 原始串口、9001 双目图像、9002 控制权。 -->
<launch>
  <!-- 统一 ROS 命名空间前缀 -->
  <arg name="namespace" default="underwater_robot"/>
  <!-- MCU 串口设备（by-id 稳定路径） -->
  <arg name="serial_port" default="/dev/serial/by-id/usb-STMicroelectronics_Lamost_UnderWater_Robot_ComPort_3588346E3134-if00"/>
  <!-- 是否启动 MCU 网关；关闭后仅剩相机与心跳节点 -->
  <arg name="gateway_enabled" default="true"/>
  <!-- 原始串口数据 TCP 端口（9000） -->
  <arg name="tcp_port" default="9000"/>
  <!-- 控制权 TCP 端口（9002） -->
  <arg name="tcp_control_port" default="9002"/>
  <!-- 是否启动双目相机 -->
  <arg name="camera_enabled" default="true"/>
  <!-- 双目相机设备节点 -->
  <arg name="camera_device" default="/dev/video0"/>
  <!-- 双目拼接 JPEG TCP 端口（9001） -->
  <arg name="camera_tcp_port" default="9001"/>
  <!-- 复用 base 层；本层不传 motor_tx，保持默认只收不发 -->
  <include file="$(find-pkg-share underwater_bringup)/launch/base.launch.xml">
    <arg name="namespace" value="$(var namespace)"/>
    <arg name="serial_port" value="$(var serial_port)"/>
    <arg name="gateway_enabled" value="$(var gateway_enabled)"/>
    <arg name="tcp_port" value="$(var tcp_port)"/>
    <arg name="tcp_control_port" value="$(var tcp_control_port)"/>
    <arg name="camera_enabled" value="$(var camera_enabled)"/>
    <arg name="camera_device" value="$(var camera_device)"/>
    <arg name="camera_tcp_port" value="$(var camera_tcp_port)"/>
  </include>
  <!-- 软件心跳节点：周期性发布 <ns>/status（默认 1 秒），不接触硬件 -->
  <node pkg="underwater_robot" exec="robot_node" name="robot_node"
        namespace="$(var namespace)" output="screen"/>
</launch>
