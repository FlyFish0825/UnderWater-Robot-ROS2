<?xml version="1.0"?>
<launch>
  <arg name="namespace" default="underwater_robot"/>
  <arg name="serial_port" default="/dev/serial/by-id/usb-STMicroelectronics_Lamost_UnderWater_Robot_ComPort_3588346E3134-if00"/>
  <arg name="gateway_enabled" default="true"/>
  <arg name="motor_tx" default="false"/>
  <arg name="tcp_port" default="0"/>
  <arg name="tcp_bind_address" default="0.0.0.0"/>
  <arg name="tcp_allow_tx" default="false"/>
  <group>
    <push-ros-namespace namespace="$(var namespace)"/>
    <node pkg="underwater_mcu_gateway" exec="mcu_gateway_node" name="mcu_gateway"
          output="screen" if="$(var gateway_enabled)">
      <param from="$(find-pkg-share underwater_bringup)/config/instances/mcu.yaml"/>
      <param name="port" value="$(var serial_port)"/>
      <param name="enable_motor_tx" value="$(var motor_tx)"/>
      <param name="tcp_port" value="$(var tcp_port)"/>
      <param name="tcp_bind_address" value="$(var tcp_bind_address)"/>
      <param name="tcp_allow_tx" value="$(var tcp_allow_tx)"/>
    </node>
    <node pkg="underwater_devices" exec="devices_node" name="devices" output="screen">
      <param from="$(find-pkg-share underwater_bringup)/config/instances/sensors.yaml"/>
    </node>
  </group>
</launch>
